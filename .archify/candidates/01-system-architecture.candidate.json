  "cards": [
    {
      "dot": "cyan",
      "title": "Client Tier (Local-First)",
      "items": [
        "Zero server login or cloud database required",
        "Documents persist completely in browser IndexedDB (paperflow_db)",
        "Sub-16ms live preview with KaTeX math rendering and A4 page simulation"
      ]
    },
    {
      "dot": "emerald",
      "title": "Backend Tier (Stateless Vector Engine)",
      "items": [
        "Express 4 server routes /api/pdf and /api/typst requests",
        "Ephemeral filesystem scratchpads created in os.tmpdir() per request",
        "Pandoc v3.6.3 transforms extended Markdown into Typst syntax",
        "Typst v0.13.0 renders publication-quality PDF in <350ms"
      ]
    },
    {
      "dot": "rose",
      "title": "Privacy & Security Posture",
      "items": [
        "No telemetry, tracking, or document storage on backend servers",
        "Temporary workspaces securely destroyed via finally cleanup blocks",
        "25MB payload threshold and 5MB Markdown size validation",
        "Runs under unprivileged 'paperflow' system user inside Docker"
      ]
    }
  ]
}