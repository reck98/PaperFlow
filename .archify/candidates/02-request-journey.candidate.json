    {
      "dot": "cyan",
      "title": "Sub-Second Turnaround",
      "items": [
        "Typst compilation is natively fast (typically 80-250ms)",
        "Zero disk persistence bottleneck beyond OS ramdisk temp files",
        "Direct binary stream avoids intermediate cloud upload delays"
      ]
    },
    {
      "dot": "emerald",
      "title": "Guaranteed Cleanup",
      "items": [
        "Ephemeral directories generated using cryptographically random UUIDs",
        "A try...finally block guarantees complete directory destruction",
        "No customer markdown or intermediate typst files persist on disk"
      ]
    },
    {
      "dot": "rose",
      "title": "Dual Delivery Mode",
      "items": [
        "Supports both binary vector PDF stream and raw Typst source code",
