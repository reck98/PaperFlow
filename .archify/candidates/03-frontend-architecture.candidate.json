    { "id": "editor-to-db", "from": "page_editor", "to": "svc_db", "label": "autosave doc", "variant": "dashed" },
    { "id": "svc-to-idb", "from": "svc_db", "to": "storage_idb", "label": "put/get doc", "variant": "emphasis" },
    { "id": "svc-to-local", "from": "svc_db", "to": "storage_local", "label": "sync activeId" }
