  "cards": [
    {
      "dot": "cyan",
      "title": "State Architecture",
      "items": [
        "EditorPage holds single source of truth for documents and active ID",
        "React refs protect async debounced saves against stale closure bugs",
        "Split-pane layout supports 50/50, editor-only, and preview-only modes"
      ]
    },
    {
      "dot": "emerald",
      "title": "Rich Preview & Editor",
      "items": [
        "CodeMirror 6 provides syntax highlighting and custom dark theme",
        "Live KaTeX preview extracts display math, matrices, and LaTeX align",
        "Outline jump navigator synchronizes headings dynamically"
      ]
    },
    {
      "dot": "rose",
      "title": "Local-First Storage",
      "items": [
        "Full offline support via browser IndexedDB",
        "No network roundtrips required for document creation, editing, or saving",
        "Sample documents automatically bootstrapped on initial launch"
      ]
    }
  ]
